# Optional — enables Claude Vision second-opinion analysis on visual audits
# and AI-drafted diffs for the top-severity issue. VibeCheck works fully
# without this (heuristic layout checks + runtime error capture only).
ANTHROPIC_API_KEY=

# Optional — used by the dashboard to load a real scan's report.json
# instead of the bundled sample. Set automatically if you use the CLI's
# printed path.
VIBECHECK_REPORT_PATH=
